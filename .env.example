# Public browser-safe Supabase config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical HTTPS app origin for authenticated Soniox completion callbacks.
NEXT_PUBLIC_APP_URL=

# Server-only Supabase config
SUPABASE_SERVICE_ROLE_KEY=

# MCP is configured in Supabase; see docs/api/mcp-plugin.md.

# Server-only provider keys
SONIOX_API_KEY=
OPENAI_API_KEY=
# Optional, required only when selecting Gemini models in the app.
GEMINI_API_KEY=
# Optional, required only when selecting Mistral models in the app.
MISTRAL_API_KEY=

# Optional server defaults.
# SONIOX_ASYNC_MODEL=stt-async-v5

# Server-only Bearer secret for POST /api/jobs/recording-transcription.
RECORDING_TRANSCRIPTION_WORKER_TOKEN=
