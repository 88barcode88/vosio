# Public browser-safe Supabase config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase config
SUPABASE_SERVICE_ROLE_KEY=

# Server-only provider keys
SONIOX_API_KEY=
# Set to eu for an EU Soniox project. Leave empty for a US Soniox project.
SONIOX_REGION=
SONIOX_TEMP_KEY_EXPIRES_SECONDS=60
OPENAI_API_KEY=
# Optional, required only when selecting Gemini models in the app.
GEMINI_API_KEY=

# Optional server defaults.
# SONIOX_API_BASE_URL=
# SONIOX_ASYNC_MODEL=stt-async-v5
# SONIOX_STT_WS_URL=
